# Copia questo file in .env e compila le chiavi

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Odds API — https://the-odds-api.com (gratuita)
ODDS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modello AI da usare via OpenRouter (es: openai/gpt-4o, anthropic/claude-3-haiku)
AI_MODEL=openai/gpt-4o-mini

# Porta del server Flask
PORT=5000

# Minuti di cache per le quote (default 30)
CACHE_MINUTES=30
